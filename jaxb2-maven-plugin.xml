<plugin>
    <groupId>org.codehaus.mojo</groupId>
    <artifactId>jaxb2-maven-plugin</artifactId>
    <version>2.5.0</version>
    <executions>
        <execution>
            <id>xjc</id>
            <goals>
                <goal>xjc</goal>
            </goals>
        </execution>
    </executions>
    <configuration>
        <schemaDirectory>src/main/java/org/example</schemaDirectory>
        <outputDirectory>src/main/java/xsd/java/objects</outputDirectory>
        <clearOutputDir>false</clearOutputDir>
    </configuration>
</plugin>

